# ==============================================================================
# KONFIGURASI LINGKUNGAN PRODUKSI (VPS ON-PREMISE BKPSDM)
# Copy file ini ke .env pada server VPS: cp .env.production.example .env
# ==============================================================================

# Database Configuration (MySQL / MariaDB di Server On-Premise)
# Jika MySQL berjalan di VPS host (luar Docker), gunakan host: host.docker.internal
# Contoh jika MySQL di host VPS:
DATABASE_URL=mysql://usul_user:PasswordKuatDatabase123!@host.docker.internal:3306/usul_data

# API & Security Configuration
PORT=3000
NODE_ENV=production
# GANTI DENGAN RANDOM STRING KUAT (minimal 32 karakter acak)
JWT_SECRET=ganti_dengan_token_jwt_sangat_rahasia_dan_panjang_minimal_32_karakter

# Frontend & Domain Configuration
APP_ORIGIN=https://asn-sync.bkpsdm.trenggalekkab.go.id
PUBLIC_API_URL=https://asn-sync.bkpsdm.trenggalekkab.go.id

# SIMPEG Integration Configuration
MOCK_SIMPEG=false
SIMPEG_UNOR_URL=https://bkdtrenggalek.net/api_tes/unit_kerja
SIMPEG_PEGAWAI_URL=https://bkdtrenggalek.net/api_tes/pegawai
SIMPEG_AUTH_USER=user_tes
SIMPEG_AUTH_PASS=password_tes

# Storage Driver Configuration: 'local' (disk lokal VPS) atau 'gdrive' (Google Drive)
STORAGE_DRIVER=local

# Google Drive Storage Configuration (Opsional jika STORAGE_DRIVER=gdrive)
MOCK_GDRIVE=false
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_ROOT_FOLDER_ID=

