{
  "name": "usul-data-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:api": "bun --filter @usul-data/api dev",
    "dev:web": "bun --filter @usul-data/web dev",
    "build": "bun --filter \"*\" build",
    "lint": "bun --filter \"*\" lint",
    "typecheck": "bun --filter \"*\" typecheck",
    "test": "bun --filter \"*\" test",
    "db:generate": "bun --filter @usul-data/shared db:generate",
    "db:migrate": "bun --filter @usul-data/shared db:migrate",
    "db:push": "bun --filter @usul-data/shared db:push"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.3"
  }
}
